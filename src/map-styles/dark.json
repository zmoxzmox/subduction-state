{
  "version": 8,
  "name": "subduction-state-dark",
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#0e1217" } },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": ["!", ["has", "brunnel"]],
      "paint": { "fill-color": "#0c1926", "fill-outline-color": "#12202e" }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": { "line-color": "#12202e", "line-width": 0.7 }
    },
    {
      "id": "landcover-ice",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", ["get", "class"], "ice"],
      "paint": { "fill-color": "#171d22", "fill-opacity": 0.6 }
    },
    {
      "id": "boundary-country",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["==", ["get", "admin_level"], 2],
      "paint": { "line-color": "#2b323a", "line-width": 0.7, "line-dasharray": [3, 2] }
    },
    {
      "id": "boundary-state",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["==", ["get", "admin_level"], 4],
      "paint": { "line-color": "#22282f", "line-width": 0.5 }
    },
    {
      "id": "road-major",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 7,
      "filter": ["<=", ["get", "class"], "motorway"],
      "paint": { "line-color": "#1c2229", "line-width": 0.6 }
    },
    {
      "id": "label-marine",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "minzoom": 1.5,
      "layout": {
        "text-field": "{name}",
        "text-font": ["Noto Sans Italic"],
        "text-size": 11,
        "text-letter-spacing": 0.2,
        "text-transform": "uppercase"
      },
      "paint": {
        "text-color": "#4b6070",
        "text-halo-color": "#0e1217",
        "text-halo-width": 1
      }
    },
    {
      "id": "label-country",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["==", ["get", "class"], "country"],
      "layout": {
        "text-field": "{name}",
        "text-font": ["Noto Sans Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 2, 10, 6, 14],
        "text-letter-spacing": 0.08,
        "text-transform": "uppercase"
      },
      "paint": {
        "text-color": "#7c858e",
        "text-halo-color": "#0e1217",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "label-city",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 5,
      "filter": ["<=", ["get", "rank"], 8],
      "layout": {
        "text-field": "{name}",
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 5, 10, 10, 13]
      },
      "paint": {
        "text-color": "#7f8891",
        "text-halo-color": "#0e1217",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "label-town",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 9,
      "filter": [">", ["get", "rank"], 8],
      "layout": {
        "text-field": "{name}",
        "text-font": ["Noto Sans Regular"],
        "text-size": 11
      },
      "paint": {
        "text-color": "#6a737c",
        "text-halo-color": "#0e1217",
        "text-halo-width": 1.2
      }
    }
  ]
}
